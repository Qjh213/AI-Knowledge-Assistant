# Copy this file to docker/.env before starting the app profile.
APP_PORT=8080

# Use a strong URL-safe password. Do not use "postgres" in production.
POSTGRES_PASSWORD=replace-with-a-strong-password

DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash

SILICONFLOW_API_KEY=replace-with-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Optional: required only when using MinerU parsing.
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4

MILVUS_TOKEN=
MAX_UPLOAD_SIZE_MB=100
BACKGROUND_WORKER_COUNT=3
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
