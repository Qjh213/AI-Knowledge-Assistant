APP_NAME=AI Knowledge Assistant
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
ENABLE_DOCS=true
EXPOSE_ERROR_DETAILS=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/knowledge

MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=document_chunks

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=2048
CONVERSATION_HISTORY_LIMIT=10

EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

DOCUMENT_STORAGE_PATH=../data/documents
MAX_UPLOAD_SIZE_MB=20
ALLOWED_DOCUMENT_EXTENSIONS=[".txt",".md",".pdf",".docx"]
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

DOCUMENT_PARSER=auto
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_ENABLE_OCR=true
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_TIMEOUT_SECONDS=600
BACKGROUND_WORKER_COUNT=3
